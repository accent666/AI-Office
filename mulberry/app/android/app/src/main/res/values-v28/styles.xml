<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- вырез камеры: рисуем и рядом с ним, а отступ под вырез задаёт MainActivity -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/mb_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/mb_bg</item>
        <item name="android:navigationBarColor">@color/mb_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
