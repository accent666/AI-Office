<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- MULBERRY: тёмная тема «клуб», фон #0d090b, без системных панелей -->
    <color name="mb_bg">#0d090b</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/mb_bg</item>
        <item name="colorPrimaryDark">@color/mb_bg</item>
        <item name="colorAccent">#e3305f</item>
        <item name="android:windowBackground">@color/mb_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/mb_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/mb_bg</item>
        <item name="android:navigationBarColor">@color/mb_bg</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/mb_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
